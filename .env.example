# Football-Data.org API key (set via the app's Settings UI)
# No need to set here — the app prompts for the key on first launch
# VITE_FOOTBALL_DATA_API_KEY=your_api_key_here

# OpenAI API key for Oracle Chat (optional — set in Vercel env vars for production)
# When set, users don't need to provide their own key. The chat proxy at /api/chat
# uses this key server-side so it's never exposed in the browser.
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic API key for Claude models in Oracle Chat (optional — alternative to OpenAI)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# AI model override (optional — defaults to gpt-4o-mini)
# Supported: gpt-4o-mini, gpt-4o, gpt-4-turbo, claude-3-5-sonnet-latest,
# claude-3-5-haiku-latest, claude-3-opus-latest
# Resolution order: request body → this env var → gpt-4o-mini
# ORACLE_AI_MODEL=gpt-4o-mini
