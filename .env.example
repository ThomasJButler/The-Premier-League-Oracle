# Football-Data.org API key (set via the app's Settings UI)
# No need to set here — the app prompts for the key on first launch
# VITE_FOOTBALL_DATA_API_KEY=your_api_key_here

# Anthropic API key for Oracle Chat + AI match analysis (optional —
# set in Vercel env vars for production). When set, users don't need
# to provide their own key. The chat proxy at /api/chat uses this key
# server-side so it's never exposed in the browser.
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# AI model override (optional — defaults to claude-haiku-4-5-20251001).
# Supported models:
#   claude-haiku-4-5-20251001   (fast + cheap, default)
#   claude-sonnet-4-6           (balanced)
#   claude-opus-4-6             (high quality)
#   claude-opus-4-7             (deepest analysis)
# Resolution order: request body → this env var → default.
# ORACLE_AI_MODEL=claude-haiku-4-5-20251001
