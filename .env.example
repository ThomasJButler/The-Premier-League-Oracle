# Supabase Configuration (for user data and predictions history)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Football Data API (Primary data source)
# Get your free API key from https://www.football-data.org/client/register
VITE_FOOTBALL_DATA_API_KEY=your_football_data_api_key

# AI Configuration (Optional - for AI Assistant)
# OpenAI: Get from https://platform.openai.com/api-keys
# Anthropic: Get from https://console.anthropic.com/account/keys
# These are stored locally in browser, not in env vars

# Additional APIs (Optional - for enhanced features)
# VITE_ODDS_API_KEY=your_odds_api_key
# VITE_WEATHER_API_KEY=your_openweather_api_key

# Backend Configuration (for Python ML service)
# VITE_ML_API_URL=http://localhost:8000

# Environment
VITE_ENV=development