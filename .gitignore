# Python virtual environments
/myenv
/PLOracle/myenv

# Node
node_modules

# Environment files (contain API keys)
.env
frontend/.env
frontend/.env*.local
backend/.env

# Build output
frontend/dist/
frontend/coverage/

# Backend generated files
backend/chroma_db/
backend/models/*.pkl
backend/models/*.joblib
# Whitelist the production model so Render's Docker build can COPY it
!backend/models/xgboost_free_tier.joblib
# Keep pre-release model backups out of git
backend/models/*.pre-*
backend/models/*.png
backend/cache/
backend/logs/
backend/mlruns/

# Playwright e2e test output
frontend/playwright-report/
frontend/playwright-screenshots/
frontend/test-results/

# Python runtime
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
backend/.coverage
backend/htmlcov/

# OS / IDE
.DS_Store
.claude/settings.json
.claude-run/
.playwright-mcp/
