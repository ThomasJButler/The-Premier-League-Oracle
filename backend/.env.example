# Premier League Oracle — Backend Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# Football-Data.org API key (free tier: 10 req/min, 1 competition)
# Register at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# --- Optional ---

# Anthropic API key — used by /chat/rag for data-grounded responses.
# When set, users do not need to provide their own key.
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# AI model override (optional — defaults to claude-haiku-4-5-20251001).
# Supported: claude-haiku-4-5-20251001, claude-sonnet-4-6,
#            claude-opus-4-6, claude-opus-4-7
# ORACLE_AI_MODEL=claude-haiku-4-5-20251001

# Draw classifier cascade threshold (optional — defaults to the tuned
# value in the trained model payload). Cascade only fires when training
# flagged it as beneficial; set ORACLE_DRAW_CASCADE=1 to force-enable
# or =0 to force-disable regardless of the payload flag.
# ORACLE_DRAW_THRESHOLD=0.42
# ORACLE_DRAW_CASCADE=1

# Redis URL — used for caching when Redis is available (optional)
# REDIS_URL=redis://localhost:6379

# MLflow tracking URI — used for experiment tracking (optional, Pro-tier)
# MLFLOW_TRACKING_URI=http://localhost:5000

# PostgreSQL password — required only if using the postgres docker-compose service
# POSTGRES_PASSWORD=
