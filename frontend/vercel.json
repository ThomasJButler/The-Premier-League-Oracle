{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/oracle/:path*", "destination": "https://premier-league-oracle-backend.onrender.com/:path*" },
    { "source": "/api/football-data/:path*", "destination": "https://api.football-data.org/v4/:path*" },
    { "source": "/((?!api/|_next/|favicon\\.ico|.*\\..*).*)", "destination": "/index.html" }
  ]
}
